{
    "compilerOptions": {
        //"ignoreDeprecations": "6.0",
        "target": "ES2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": "./src",
        "paths": {
            "@/backend/*": [
                "backend/*"
            ],
            "@/app/*": [
                "app/*"
            ],
            "@/components/*": [
                "components/*"
            ],
            "@/lib/*": [
                "lib/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}